# --- Fastify Control Plane (Railway) ------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/sentinel_grid
PORT=8080
NODE_ENV=production
JWT_SECRET=change-me-to-a-random-64-char-secret
COOKIE_SECRET=change-me-to-another-random-64-char-secret

# Browser origins allowed to call the API. Comma-separated HTTPS origins.
# Set CORS_ALLOW_CLOUDFLARE=true to allow Cloudflare Pages, Workers, and
# temporary trycloudflare.com HTTPS origins in addition to this exact list.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CLOUDFLARE=false

# Optional � email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password

# Managed Cloudflare tunnels for production Edge Agents. Set all values together.
EDGE_MANAGED_TUNNEL_REQUIRED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
EDGE_MEDIA_BASE_DOMAIN=
