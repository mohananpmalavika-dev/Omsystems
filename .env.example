# --- Fastify Control Plane (Railway) ------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/sentinel_grid
PORT=8080
NODE_ENV=production
JWT_SECRET=change-me-to-a-random-64-char-secret
COOKIE_SECRET=change-me-to-another-random-64-char-secret

# Optional — email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password

# Optional — Cloudflare Tunnel token (edge agent connectivity)
CLOUDFLARE_TUNNEL_TOKEN=
