HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
AUTH_MODE=development
# Production must use session/oidc and non-placeholder secrets. Every sensitive
# variable also supports a Docker/Kubernetes secret file, e.g. DATABASE_URL_FILE.
MAX_IN_FLIGHT_REQUESTS=500
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000
DATABASE_URL=postgresql://sentinel:local-development-only@localhost:5432/sentinel
MEDIA_GATEWAY_SHARED_KEY=development-media-gateway-key-change-me
# Public browser/branch-agent URL embedded into downloaded installer packages.
# It must be reachable from branch networks in production.
CONTROL_PLANE_PUBLIC_URL=http://localhost:8080
EDGE_BRIDGE_SHARED_KEY=development-edge-bridge-key-change-me
RECORDING_ENGINE_URL=http://localhost:8091
RECORDING_ENGINE_SHARED_KEY=development-recording-engine-key-change-me
# Analytics engine processes video frames and generates AI-powered detections
ANALYTICS_ENGINE_URL=http://localhost:8092
ANALYTICS_ENGINE_SHARED_KEY=development-analytics-engine-key-change-me
ANALYTICS_SOURCE_SHARED_KEY=development-analytics-source-key-change-me
# Automatic P1/P2 popup evidence is captured by the recording engine. The
# concurrency limit protects camera/CPU capacity during an alert burst.
ALERT_EVIDENCE_CLIP_SECONDS=20
ALERT_EVIDENCE_MAX_CONCURRENT=4
# Continuous DVR/NVR footage remains at the branch. Configure S3-compatible
# storage only for selected incident snapshots and clips.
EVIDENCE_ARCHIVE_REQUIRED=false
# EVIDENCE_S3_BUCKET=sentinel-incident-evidence
# EVIDENCE_S3_REGION=ap-south-1
# EVIDENCE_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# EVIDENCE_S3_ACCESS_KEY_ID=
# EVIDENCE_S3_SECRET_ACCESS_KEY=
# EVIDENCE_S3_ENCRYPTION=AES256
# EVIDENCE_S3_OBJECT_LOCK_DAYS=365
# The same JSON secret-reference map is supplied only to media/recording workers.
# VPN-direct cameras are registered with opaque vpn:// references. The media and
# recording workers must run on a network with routes through the site-to-site
# VPN and receive the matching private RTSP/DVR endpoint only through this
# secret map. Never commit production camera, DVR, or router credentials.
# Example shape only: {"vpn://branch-001/camera/10.42.5.20":"rtsp://..."}
STREAM_SECRETS_JSON={}
REPORT_DOWNLOAD_SECRET=development-report-download-secret-change-me
REPORT_WORKER_SHARED_KEY=development-report-worker-key-change-me
REPORT_PUBLIC_BASE_URL=http://localhost:8080
REPORT_ARCHIVE_RETENTION_DAYS=365

# Federation gateway. Use the same rotated key on trusted global/regional
# control centers; individual heartbeat identities use per-server secrets.
FEDERATION_SHARED_KEY=development-federation-peer-key-change-me
FEDERATION_PEER_TIMEOUT_MS=8000
FEDERATION_HEARTBEAT_TTL_SECONDS=90

# Digital Twin floor-plan bytes. Use a private persistent volume in production;
# the local default is intentionally suitable only for development.
DIGITAL_TWIN_ASSET_ROOT=./digital-twin-assets

# P1 voice calls (choose twilio or exotel). ALERT_PUBLIC_BASE_URL must be a
# provider-reachable HTTPS URL; rotate the callback secret before production.
# ALERT_VOICE_PROVIDER=twilio
# ALERT_VOICE_FAILOVER_PROVIDER=exotel
# ALERT_PUBLIC_BASE_URL=https://surveillance.example.com
# ALERT_VOICE_CALLBACK_SECRET=replace-with-a-long-random-secret
# TWILIO_FROM_NUMBER=+910000000000
# EXOTEL_ACCOUNT_SID=your-account-sid
# EXOTEL_API_KEY=your-api-key
# EXOTEL_API_TOKEN=your-api-token
# EXOTEL_CALLER_ID=+910000000000
# EXOTEL_SUBDOMAIN=api.in.exotel.com

# P1/P2 SMS gateway (msg91, textlocal, or twilio). Uses ALERT_PUBLIC_BASE_URL
# and ALERT_VOICE_CALLBACK_SECRET above for signed delivery callbacks.
# ALERT_SMS_PROVIDER=msg91
# ALERT_SMS_FAILOVER_PROVIDER=twilio
# MSG91_AUTH_KEY=your-auth-key
# Configure approved MSG91 Flow/DLT template IDs per tenant through smsTemplateIds
# in PUT /v1/alerts/notification-policy.
# Configure the MSG91 delivery webhook as:
# https://surveillance.example.com/internal/alerts/sms/status
# TEXTLOCAL_API_KEY=your-api-key
# TEXTLOCAL_SENDER_ID=OMSYST

# Alert email (smtp, sendgrid, or ses). The optional secondary provider is
# attempted immediately before the dispatcher's normal retry cycle.
# ALERT_EMAIL_PROVIDER=ses
# ALERT_EMAIL_FAILOVER_PROVIDER=sendgrid
# ALERT_EMAIL_FROM=alerts@example.com
# ALERT_AWS_REGION=ap-south-1
# ALERT_SMTP_URL=smtps://username:password@smtp.example.com:465
# ALERT_SENDGRID_API_KEY=your-api-key
# TWILIO_SMS_FROM_NUMBER=+910000000000

# ============================================================================
# Notification Configuration (for Maintenance Alerts)
# ============================================================================

# Email Provider (sendgrid, ses, or smtp)
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=notifications@yourdomain.com

# SendGrid Configuration
# EMAIL_API_KEY=SG.your_sendgrid_api_key

# AWS SES Configuration
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret

# SMTP Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# SMS Provider (twilio, sns, or custom)
# SMS_PROVIDER=twilio
# SMS_FROM=+1234567890

# Twilio Configuration
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token

# Custom SMS Gateway
# SMS_API_URL=https://sms-gateway.example.com/send
# SMS_API_KEY=your_api_key

# Webhook Configuration (comma-separated URLs)
# WEBHOOK_URLS=https://your-domain.com/webhook,https://backup-webhook.com/alerts
# WEBHOOK_RETRY_ATTEMPTS=3
# WEBHOOK_TIMEOUT_MS=10000
# WEBHOOK_HEADERS={"Authorization":"Bearer your_token"}


# ============================================================================
# JWT Authentication Configuration (REQUIRED for WebSocket authentication)
# ============================================================================

# JWT Secret - MUST be changed in production (generate with: openssl rand -hex 64)
JWT_SECRET=development-jwt-secret-change-me-in-production
FEDERATION_JWT_SECRET=development-federation-jwt-secret-change-me

# JWT Configuration
JWT_ISSUER=kryptonvision
JWT_AUDIENCE=kryptonvision-api

# Session Configuration
SESSION_EXPIRY_HOURS=24
SESSION_CLEANUP_INTERVAL_MS=3600000

# WebSocket Configuration
WEBSOCKET_PING_TIMEOUT=60000
WEBSOCKET_PING_INTERVAL=25000
