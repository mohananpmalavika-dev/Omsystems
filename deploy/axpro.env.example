# Set on dashboard and control plane; never expose as NEXT_PUBLIC variables.
AXPRO_SECRET_VAULT_PROVIDER=HASHICORP_VAULT
AXPRO_SECRET_VAULT_ENDPOINT=https://vault.service.internal
AXPRO_SECRET_VAULT_TOKEN=
AXPRO_SECRET_VAULT_NAMESPACE=
# Set on control plane; requires private routing to the panel.
AXPRO_POLLING_ENABLED=false
# Dashboard only: JSON keyed by tenant UUID + ':' + integration UUID.
AXPRO_RECEIVER_SECRETS={}
# Receiver host only: signed forwarding hook settings.
AXPRO_FORWARD_BASE_URL=https://dashboard.example.com
AXPRO_FORWARD_TENANT_ID=
AXPRO_FORWARD_INTEGRATION_ID=
AXPRO_FORWARD_SECRET=
