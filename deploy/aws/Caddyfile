# =================================================================
# Sentinel Grid - Caddy Automated SSL Reverse Proxy
# =================================================================

{
    # Global options
    admin off
    email dhanyamohan@kryptonlogic.com
    auto_https disable_redirects
}

http://3-7-216-169.sslip.io, http://3.7.216.169.sslip.io, http://3.7.216.169, :80 {
    encode zstd gzip

    header {
        -X-Frame-Options
        Content-Security-Policy "frame-ancestors 'self' https://* http://localhost:* https://kryptonlogic-ebe5a.web.app https://kryptonlogic.com https://*.kryptonlogic.com;"
    }

    handle_path /stream/* {
        reverse_proxy media-gateway:8888 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    handle /hls/* {
        reverse_proxy media-gateway:8090
    }

    handle /ready {
        reverse_proxy control-plane:8080
    }

    handle /health {
        reverse_proxy control-plane:8080
    }

    handle /webrtc/* {
        reverse_proxy media-gateway:8090
    }

    handle /api/portable-camera/* {
        reverse_proxy control-plane:8080
    }

    handle /ws/* {
        reverse_proxy control-plane:8080 {
            header_up Upgrade {>Upgrade}
            header_up Connection {>Connection}
        }
    }

    handle {
        reverse_proxy dashboard:10000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto http
        }
    }
}

https://3-7-216-169.sslip.io, https://3.7.216.169.sslip.io {
    encode zstd gzip

    tls {
        issuer acme {
            email dhanyamohan@kryptonlogic.com
        }
    }

    header {
        -X-Frame-Options
        Content-Security-Policy "frame-ancestors 'self' https://* http://localhost:* https://kryptonlogic-ebe5a.web.app https://kryptonlogic.com https://*.kryptonlogic.com;"
    }

    handle_path /stream/* {
        reverse_proxy media-gateway:8888 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    handle /hls/* {
        reverse_proxy media-gateway:8090
    }

    handle /ready {
        reverse_proxy control-plane:8080
    }

    handle /health {
        reverse_proxy control-plane:8080
    }

    handle /webrtc/* {
        reverse_proxy media-gateway:8090
    }

    handle /api/portable-camera/* {
        reverse_proxy control-plane:8080
    }

    handle /ws/* {
        reverse_proxy control-plane:8080 {
            header_up Upgrade {>Upgrade}
            header_up Connection {>Connection}
        }
    }

    handle {
        reverse_proxy dashboard:10000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
        }
    }
}
