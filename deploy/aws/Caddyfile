# =================================================================
# Sentinel Grid - Caddy Automated SSL Reverse Proxy
# =================================================================

{
    # Global options
    admin off
    email dhanyamohan@kryptonlogic.com
}

3-7-216-169.sslip.io, 3.7.216.169.sslip.io, :80, :443 {
    # Encode responses with zstd or gzip
    encode zstd gzip

    # Remove restrictive frame headers and allow modal iframe embedding
    header {
        -X-Frame-Options
        Content-Security-Policy "frame-ancestors 'self' https://* http://localhost:* https://kryptonlogic-ebe5a.web.app https://kryptonlogic.com https://*.kryptonlogic.com;"
    }

    # 1. MediaMTX Live Video Streams (HLS & WebRTC WHEP)
    handle_path /stream/* {
        reverse_proxy media-gateway:8888 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # 2. Direct Control Plane endpoints & WebSockets
    handle /ready {
        reverse_proxy control-plane:8080
    }

    handle /health {
        reverse_proxy control-plane:8080
    }

    handle /ws/* {
        reverse_proxy control-plane:8080 {
            header_up Upgrade {>Upgrade}
            header_up Connection {>Connection}
        }
    }

    # 3. Next.js Web Dashboard & BFF (/api/control/*)
    handle {
        reverse_proxy dashboard:10000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
