# Values issued by Sentinel Grid when this appliance is assigned to a branch.
CONTROL_PLANE_URL=https://control.example.com
BRANCH_ID=00000000-0000-0000-0000-000000000000
EDGE_AGENT_ID=00000000-0000-0000-0000-000000000000
EDGE_AGENT_NAME=Branch 001 Gateway
EDGE_BRIDGE_SHARED_KEY=replace-with-at-least-32-random-characters

# Create one remotely managed, named Cloudflare Tunnel per branch. Configure
# its public hostname to send HTTP traffic to http://edge-agent:8090.
PUBLIC_MEDIA_GATEWAY_URL=https://branch-001.media.example.com
CLOUDFLARED_TUNNEL_TOKEN=replace-with-the-branch-tunnel-token

# Shared camera credentials are optional. Leave blank when credentials are
# provisioned by the secure camera-credential workflow.
CAMERA_USERNAME=admin
CAMERA_PASSWORD=
ONVIF_ENDPOINTS=

# Optional recorder and dual-WAN probes. Keep valid JSON on one line.
RECORDERS_JSON=[]
INTERNET_LINKS_JSON=[]

