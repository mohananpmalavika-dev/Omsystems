# Values issued by Sentinel Grid when this appliance is assigned to a branch.
CONTROL_PLANE_URL=https://control.example.com
EDGE_ACTIVATION_CODE=sgact_replace-with-one-time-code-from-branch-onboarding
EDGE_AGENT_NAME=Branch 001 Gateway
EDGE_OFFLINE_OUTBOX_MAX_ITEMS=10000

# The control plane creates the named Cloudflare Tunnel, DNS hostname, and
# remote ingress rule. Its token is returned only to this activated gateway
# and stored inside the encrypted device identity; do not add it here.
ONVIF_ENDPOINTS=
AUTO_DISCOVERY_ENABLED=true
AUTO_DISCOVERY_INTERVAL_MS=900000

# Optional recorder and dual-WAN probes. Keep valid JSON on one line.
RECORDERS_JSON=[]
INTERNET_LINKS_JSON=[]
