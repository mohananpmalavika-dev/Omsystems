# =================================================================
# Sentinel Grid / KryptonVision - Oracle Cloud (OCI) Caddyfile
# Automatic HTTPS Reverse Proxy & WebRTC Stream Router
# =================================================================

{
    admin off
    email ${ADMIN_EMAIL:-service@omsystemandservice.in}
}

# In OCI, this site block handles both custom domain and sslip.io fallback
{$DOMAIN_NAME:localhost}, {$OCI_PUBLIC_IP_DOMAIN:localhost} {
    header {
        -X-Frame-Options
        Content-Security-Policy "frame-ancestors 'self' https://* http://localhost:* https://*.omsystemandservice.in https://*.kryptonlogic.com;"
        Permissions-Policy "camera=*, microphone=*, display-capture=*, geolocation=*"
    }

    redir /control_room /control-room 308
    redir /control_room/* /control-room/{uri} 308

    @static path /_next/static/*
    header @static {
        Cache-Control "public, max-age=31536000, immutable"
    }

    # Stream Media Gateway (RTSP / WebRTC / HLS)
    handle_path /stream/* {
        reverse_proxy media-gateway:8888 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            flush_interval -1
        }
    }

    handle /hls/* {
        reverse_proxy media-gateway:8090 {
            flush_interval -1
        }
    }

    handle /webrtc/* {
        reverse_proxy media-gateway:8090 {
            flush_interval -1
        }
    }

    # Health & Telemetry
    handle /ready {
        reverse_proxy control-plane:8080
    }

    handle /health {
        reverse_proxy control-plane:8080
    }

    handle /metrics {
        reverse_proxy control-plane:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            flush_interval -1
        }
    }

    # API Endpoints
    handle /api/vms/* {
        reverse_proxy control-plane:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
            flush_interval -1
        }
    }

    handle /api/portable-camera/* {
        reverse_proxy control-plane:8080
    }

    handle /api/ai/* {
        reverse_proxy control-plane:8080
    }

    handle /api/mobile/* {
        reverse_proxy control-plane:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
            flush_interval -1
        }
    }

    handle /v1/* {
        reverse_proxy control-plane:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
            flush_interval -1
        }
    }

    # WebSockets
    @ws {
        path /ws /ws/* /socket.io /socket.io/*
    }
    handle @ws {
        reverse_proxy control-plane:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
            flush_interval -1
        }
    }

    # Next.js Dashboard Frontend
    handle {
        reverse_proxy dashboard:10000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
            flush_interval -1
        }
    }
}
