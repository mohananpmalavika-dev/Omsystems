# =================================================================
# Sentinel Grid (KryptoVision) - GCP Caddy Automated SSL Reverse Proxy
# =================================================================

{
    admin off
    email mohanpmalavika@gmail.com
}

# Redirect all plain IP HTTP traffic to the HTTPS domain
http://34.14.220.41, :80 {
    # Let Caddy handle ACME HTTP-01 challenges automatically
    redir https://34-14-220-41.sslip.io{uri} permanent
}

34-14-220-41.sslip.io {
    header {
        -X-Frame-Options
        Content-Security-Policy "frame-ancestors 'self' https://* http://localhost:* https://kryptonlogic-ebe5a.web.app https://kryptonlogic.com https://*.kryptonlogic.com;"
        Permissions-Policy "camera=*, microphone=*, display-capture=*, geolocation=*"
    }

    @static path /_next/static/*
    header @static {
        Cache-Control "public, max-age=31536000, immutable"
    }

    handle_path /stream/* {
        reverse_proxy media-gateway:8888 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            flush_interval -1
        }
    }

    handle /hls/* {
        reverse_proxy media-gateway:8090 {
            flush_interval -1
        }
    }

    handle /ready {
        reverse_proxy control-plane:8080
    }

    handle /health {
        reverse_proxy control-plane:8080
    }

    handle /metrics {
        reverse_proxy control-plane:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            flush_interval -1
        }
    }

    handle /api/vms/* {
        reverse_proxy control-plane:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
            flush_interval -1
        }
    }

    handle /webrtc/* {
        reverse_proxy media-gateway:8090 {
            flush_interval -1
        }
    }

    handle /api/portable-camera/* {
        reverse_proxy control-plane:8080
    }

    handle /api/ai/* {
        reverse_proxy control-plane:8080
    }

    handle /api/mobile/* {
        reverse_proxy control-plane:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
            flush_interval -1
        }
    }

    handle /ws/* {
        reverse_proxy control-plane:8080 {
            header_up Upgrade {>Upgrade}
            header_up Connection {>Connection}
        }
    }

    handle /v1/* {
        reverse_proxy control-plane:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
            flush_interval -1
        }
    }

    handle {
        reverse_proxy dashboard:10000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
            flush_interval -1
        }
    }
}

# Optional branch media sites live in ./sites. An empty glob is valid, so the
# existing dashboard deployment keeps working until a site is enabled.
import sites/*.caddy
