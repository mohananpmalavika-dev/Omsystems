{
  "comment": "Enterprise Authentication Configuration Examples",
  "description": "Production-ready configuration templates for SAML, OIDC, and LDAP authentication providers",
  
  "saml_configurations": {
    "azure_ad": {
      "tenantId": "acme-corp",
      "entryPoint": "https://login.microsoftonline.com/{TENANT_ID}/saml2",
      "issuer": "https://sentinel.example.com/saml/metadata",
      "callbackUrl": "https://sentinel.example.com/api/v1/auth/saml/callback",
      "logoutUrl": "https://login.microsoftonline.com/{TENANT_ID}/saml2/logout",
      "cert": "-----BEGIN CERTIFICATE-----\nMIIC8DCCAdigAwIBAgIQxxxxxxxxxxxxxxxxxxxxxx...\n-----END CERTIFICATE-----",
      "identifierFormat": "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent",
      "wantAssertionsSigned": true,
      "wantAuthnResponseSigned": true,
      "attributeMapping": {
        "userId": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name",
        "email": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress",
        "firstName": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/givenname",
        "lastName": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/surname",
        "displayName": "http://schemas.microsoft.com/identity/claims/displayname",
        "groups": "http://schemas.microsoft.com/ws/2008/06/identity/claims/groups"
      },
      "clockTolerance": 60
    },
    
    "okta": {
      "tenantId": "acme-corp",
      "entryPoint": "https://acme-corp.okta.com/app/exkxxxxxxxxxxxxxx/sso/saml",
      "issuer": "http://www.okta.com/exkxxxxxxxxxxxxxx",
      "callbackUrl": "https://sentinel.example.com/api/v1/auth/saml/callback",
      "logoutUrl": "https://acme-corp.okta.com/app/exkxxxxxxxxxxxxxx/slo/saml",
      "cert": "-----BEGIN CERTIFICATE-----\nMIIDpDCCAoygAwIBAgIGAXoxxxxxxxxxxxxxx...\n-----END CERTIFICATE-----",
      "identifierFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress",
      "wantAssertionsSigned": true,
      "attributeMapping": {
        "userId": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier",
        "email": "email",
        "firstName": "firstName",
        "lastName": "lastName",
        "displayName": "displayName"
      }
    },
    
    "auth0": {
      "tenantId": "acme-corp",
      "entryPoint": "https://acme-corp.auth0.com/samlp/xxxxxxxxxxxxxxxxxxx",
      "issuer": "urn:acme-corp.auth0.com",
      "callbackUrl": "https://sentinel.example.com/api/v1/auth/saml/callback",
      "cert": "-----BEGIN CERTIFICATE-----\nMIIDHTCCAgWgAwIBAgIJxxxxxxxxxxxxxxxxxx...\n-----END CERTIFICATE-----",
      "identifierFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress",
      "wantAssertionsSigned": true
    },
    
    "onelogin": {
      "tenantId": "acme-corp",
      "entryPoint": "https://app.onelogin.com/trust/saml2/http-post/sso/xxxxxx",
      "issuer": "https://app.onelogin.com/saml/metadata/xxxxxx",
      "callbackUrl": "https://sentinel.example.com/api/v1/auth/saml/callback",
      "logoutUrl": "https://app.onelogin.com/trust/saml2/http-redirect/slo/xxxxxx",
      "cert": "-----BEGIN CERTIFICATE-----\nMIIEFzCCAv+gAwIBAgIUxxxxxxxxxxxxxxxxxx...\n-----END CERTIFICATE-----",
      "identifierFormat": "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent",
      "wantAssertionsSigned": true,
      "wantAuthnResponseSigned": true
    }
  },
  
  "oidc_configurations": {
    "azure_ad": {
      "tenantId": "acme-corp",
      "provider": "azure-ad",
      "issuerUrl": "https://login.microsoftonline.com/{TENANT_ID}/v2.0",
      "clientId": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
      "clientSecret": "REPLACE_WITH_CLIENT_SECRET",
      "redirectUri": "https://sentinel.example.com/api/v1/auth/oidc/callback",
      "scopes": ["openid", "profile", "email", "offline_access", "User.Read"],
      "attributeMapping": {
        "userId": "oid",
        "email": "email",
        "firstName": "given_name",
        "lastName": "family_name",
        "displayName": "name",
        "groups": "groups"
      },
      "requirePKCE": true,
      "clockTolerance": 60
    },
    
    "okta": {
      "tenantId": "acme-corp",
      "provider": "okta",
      "issuerUrl": "https://acme-corp.okta.com/oauth2/default",
      "clientId": "0oaxxxxxxxxxxxxxx",
      "clientSecret": "REPLACE_WITH_CLIENT_SECRET",
      "redirectUri": "https://sentinel.example.com/api/v1/auth/oidc/callback",
      "scopes": ["openid", "profile", "email", "groups", "offline_access"],
      "attributeMapping": {
        "userId": "sub",
        "email": "email",
        "firstName": "given_name",
        "lastName": "family_name",
        "displayName": "name",
        "groups": "groups"
      },
      "requirePKCE": true
    },
    
    "auth0": {
      "tenantId": "acme-corp",
      "provider": "auth0",
      "issuerUrl": "https://acme-corp.auth0.com",
      "clientId": "xxxxxxxxxxxxxxxxxxxxxxxx",
      "clientSecret": "REPLACE_WITH_CLIENT_SECRET",
      "redirectUri": "https://sentinel.example.com/api/v1/auth/oidc/callback",
      "scopes": ["openid", "profile", "email", "offline_access"],
      "attributeMapping": {
        "userId": "sub",
        "email": "email",
        "firstName": "given_name",
        "lastName": "family_name",
        "displayName": "name"
      }
    },
    
    "keycloak": {
      "tenantId": "acme-corp",
      "provider": "keycloak",
      "issuerUrl": "https://keycloak.example.com/auth/realms/sentinel",
      "clientId": "sentinel-grid",
      "clientSecret": "REPLACE_WITH_CLIENT_SECRET",
      "redirectUri": "https://sentinel.example.com/api/v1/auth/oidc/callback",
      "scopes": ["openid", "profile", "email", "roles"],
      "attributeMapping": {
        "userId": "sub",
        "email": "email",
        "firstName": "given_name",
        "lastName": "family_name",
        "displayName": "name",
        "groups": "groups"
      }
    },
    
    "google_workspace": {
      "tenantId": "acme-corp",
      "provider": "google",
      "issuerUrl": "https://accounts.google.com",
      "clientId": "xxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com",
      "clientSecret": "REPLACE_WITH_CLIENT_SECRET",
      "redirectUri": "https://sentinel.example.com/api/v1/auth/oidc/callback",
      "scopes": ["openid", "profile", "email"],
      "attributeMapping": {
        "userId": "sub",
        "email": "email",
        "firstName": "given_name",
        "lastName": "family_name",
        "displayName": "name"
      }
    }
  },
  
  "ldap_configurations": {
    "active_directory_standard": {
      "tenantId": "acme-corp",
      "url": "ldap://dc.example.com:389",
      "baseDN": "dc=example,dc=com",
      "bindDN": "cn=sentinel-svc,ou=service-accounts,dc=example,dc=com",
      "bindPassword": "REPLACE_WITH_SERVICE_ACCOUNT_PASSWORD",
      "userSearchBase": "ou=users,dc=example,dc=com",
      "userSearchFilter": "(sAMAccountName={{username}})",
      "groupSearchBase": "ou=groups,dc=example,dc=com",
      "groupSearchFilter": "(member={{dn}})",
      "attributeMapping": {
        "userId": "sAMAccountName",
        "email": "mail",
        "firstName": "givenName",
        "lastName": "sn",
        "displayName": "displayName",
        "memberOf": "memberOf"
      },
      "connectTimeout": 10000,
      "idleTimeout": 300000,
      "poolSize": 5
    },
    
    "active_directory_secure": {
      "tenantId": "acme-corp",
      "url": "ldaps://dc.example.com:636",
      "baseDN": "dc=example,dc=com",
      "bindDN": "cn=sentinel-svc,ou=service-accounts,dc=example,dc=com",
      "bindPassword": "REPLACE_WITH_SERVICE_ACCOUNT_PASSWORD",
      "userSearchBase": "ou=users,dc=example,dc=com",
      "userSearchFilter": "(sAMAccountAccount={{username}})",
      "groupSearchBase": "ou=groups,dc=example,dc=com",
      "groupSearchFilter": "(member={{dn}})",
      "tlsOptions": {
        "rejectUnauthorized": true,
        "ca": ["-----BEGIN CERTIFICATE-----\nMIIDXTCCAkWgAwIBAgIJAxxxxxxxxxxxxxxx...\n-----END CERTIFICATE-----"]
      },
      "attributeMapping": {
        "userId": "sAMAccountName",
        "email": "mail",
        "firstName": "givenName",
        "lastName": "sn",
        "displayName": "displayName",
        "memberOf": "memberOf"
      },
      "connectTimeout": 10000,
      "idleTimeout": 300000,
      "poolSize": 10
    },
    
    "openldap": {
      "tenantId": "acme-corp",
      "url": "ldap://ldap.example.com:389",
      "baseDN": "dc=example,dc=com",
      "bindDN": "cn=admin,dc=example,dc=com",
      "bindPassword": "REPLACE_WITH_ADMIN_PASSWORD",
      "userSearchBase": "ou=people,dc=example,dc=com",
      "userSearchFilter": "(uid={{username}})",
      "groupSearchBase": "ou=groups,dc=example,dc=com",
      "groupSearchFilter": "(memberUid={{username}})",
      "attributeMapping": {
        "userId": "uid",
        "email": "mail",
        "firstName": "givenName",
        "lastName": "sn",
        "displayName": "displayName",
        "memberOf": "memberOf"
      },
      "connectTimeout": 10000,
      "poolSize": 5
    },
    
    "freeipa": {
      "tenantId": "acme-corp",
      "url": "ldaps://ipa.example.com:636",
      "baseDN": "dc=example,dc=com",
      "bindDN": "uid=sentinel-svc,cn=users,cn=accounts,dc=example,dc=com",
      "bindPassword": "REPLACE_WITH_SERVICE_ACCOUNT_PASSWORD",
      "userSearchBase": "cn=users,cn=accounts,dc=example,dc=com",
      "userSearchFilter": "(uid={{username}})",
      "groupSearchBase": "cn=groups,cn=accounts,dc=example,dc=com",
      "groupSearchFilter": "(member={{dn}})",
      "tlsOptions": {
        "rejectUnauthorized": true
      },
      "attributeMapping": {
        "userId": "uid",
        "email": "mail",
        "firstName": "givenName",
        "lastName": "sn",
        "displayName": "displayName",
        "memberOf": "memberOf"
      }
    }
  },
  
  "multi_tenant_examples": {
    "banking_customer": {
      "tenantId": "first-national-bank",
      "saml": {
        "entryPoint": "https://sso.firstnationalbank.com/saml2/idp/sso",
        "issuer": "https://sentinel.example.com/saml/metadata/first-national-bank",
        "cert": "BANK_PROVIDED_CERTIFICATE"
      },
      "oidc_fallback": {
        "provider": "azure-ad",
        "issuerUrl": "https://login.microsoftonline.com/bank-tenant-id/v2.0"
      }
    },
    
    "government_customer": {
      "tenantId": "city-surveillance",
      "ldap": {
        "url": "ldaps://govt-dc.city.gov:636",
        "baseDN": "dc=city,dc=gov",
        "userSearchBase": "ou=police,ou=users,dc=city,dc=gov"
      }
    },
    
    "retail_customer": {
      "tenantId": "retail-chain",
      "oidc": {
        "provider": "okta",
        "issuerUrl": "https://retail-chain.okta.com/oauth2/default"
      }
    }
  },
  
  "environment_variables": {
    "production": {
      "JWT_SECRET": "REPLACE_WITH_STRONG_RANDOM_SECRET_256_BITS",
      "JWT_EXPIRATION": "8h",
      "SSO_SESSION_TIMEOUT": "28800",
      "SAML_CLOCK_TOLERANCE": "60",
      "OIDC_CLOCK_TOLERANCE": "60",
      "LDAP_CONNECTION_TIMEOUT": "10000",
      "LDAP_POOL_SIZE": "10",
      "ENABLE_SSO_AUDIT_LOGS": "true",
      "SSO_FAILURE_ALERT_THRESHOLD": "10"
    }
  },
  
  "curl_examples": {
    "configure_saml": "curl -X POST 'https://sentinel.example.com/api/v1/auth/enterprise/saml/configure' -H 'Authorization: Bearer ADMIN_TOKEN' -H 'Content-Type: application/json' -d @saml-config.json",
    
    "configure_oidc": "curl -X POST 'https://sentinel.example.com/api/v1/auth/enterprise/oidc/configure' -H 'Authorization: Bearer ADMIN_TOKEN' -H 'Content-Type: application/json' -d @oidc-config.json",
    
    "configure_ldap": "curl -X POST 'https://sentinel.example.com/api/v1/auth/enterprise/ldap/configure' -H 'Authorization: Bearer ADMIN_TOKEN' -H 'Content-Type: application/json' -d @ldap-config.json",
    
    "test_saml": "curl 'https://sentinel.example.com/api/v1/auth/enterprise/test/saml/acme-corp' -H 'Authorization: Bearer ADMIN_TOKEN'",
    
    "test_ldap": "curl 'https://sentinel.example.com/api/v1/auth/enterprise/test/ldap/acme-corp' -H 'Authorization: Bearer ADMIN_TOKEN'",
    
    "ldap_login": "curl -X POST 'https://sentinel.example.com/api/v1/auth/ldap/login' -H 'Content-Type: application/json' -d '{\"tenantId\":\"acme-corp\",\"username\":\"john.doe\",\"password\":\"SecurePass123\"}'"
  }
}
