{
  "name": "@sentinel/edge-agent",
  "version": "0.1.24",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "clean": "node scripts/clean-build.mjs",
    "build": "npm run clean && npm run build:tsc",
    "build:tsc": "tsc -p tsconfig.build.json",
    "build:clean": "npm run build",
    "fetch:windows-runtime": "node scripts/fetch-windows-runtime.mjs",
    "verify:windows-installer-assets": "node scripts/verify-windows-installer-assets.mjs",
    "verify:windows-package": "node scripts/verify-windows-package.mjs",
    "verify:windows-production-release": "node scripts/verify-windows-production-release.mjs",
    "stage:windows-native-modules": "node scripts/stage-windows-native-modules.mjs",
    "verify:secure-face-models": "node scripts/verify-secure-face-models.mjs",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --external:onnxruntime-node --external:sharp --outfile=build/edge-agent.cjs",
    "bundle:delta": "node scripts/build-delta-bundle.mjs",
    "build:exe": "npm run clean && npm run fetch:windows-runtime && npm run verify:windows-installer-assets && npm run typecheck && npm run bundle && npm run stage:windows-native-modules && npx @yao-pkg/pkg --config package.json --target node22-win-x64 --output release/edge-agent.exe build/edge-agent.cjs && npm run verify:windows-package",
    "build:signed-windows-release": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File scripts/build-signed-windows-release.ps1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "fast-xml-parser": "^5.2.5",
    "onnxruntime-node": "^1.29.0",
    "pg": "^8.22.0",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "pkg": {
    "assets": [
      "vendor/windows/**/*",
      "models/secure-face/**/*",
      "../node_modules/onnxruntime-node/bin/napi-v6/win32/x64/*",
      "../node_modules/@img/sharp-win32-x64/**/*",
      "release/node_modules/**/*"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.21.0",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
