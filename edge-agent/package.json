{
  "name": "@sentinel/edge-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node18 --outfile=build/edge-agent.cjs",
    "build:exe": "npm run typecheck && npm run bundle && pkg --target node18-win-x64 --output release/edge-agent.exe build/edge-agent.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "zod": "^3.25.76"
  },
  "pkg": {
    "scripts": [
      "build/edge-agent.cjs"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "esbuild": "^0.25.0",
    "pkg": "^5.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
