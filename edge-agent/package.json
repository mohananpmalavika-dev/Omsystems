{
  "name": "@sentinel/edge-agent",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "clean": "node scripts/clean-build.mjs",
    "build": "npm run clean && npm run build:tsc",
    "build:tsc": "tsc -p tsconfig.build.json",
    "build:clean": "npm run build",
    "fetch:windows-runtime": "node scripts/fetch-windows-runtime.mjs",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node18 --outfile=build/edge-agent.cjs",
    "build:exe": "npm run clean && npm run fetch:windows-runtime && npm run typecheck && npm run bundle && pkg --config package.json --target node18-win-x64 --output release/edge-agent.exe build/edge-agent.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "pg": "^8.22.0",
    "zod": "^3.25.76"
  },
  "pkg": {
    "assets": [
      "vendor/windows/**/*",
      "installer/windows/*.ps1"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.21.0",
    "esbuild": "^0.25.0",
    "pkg": "^5.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
