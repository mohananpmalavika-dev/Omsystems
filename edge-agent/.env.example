CONTROL_PLANE_URL=http://localhost:8080
BRANCH_ID=branch-blr-001
EDGE_AGENT_NAME=BLR-001 Edge
EDGE_AGENT_VERSION=0.1.1
# Development only. Production branch packages use EDGE_BRIDGE_SHARED_KEY.
DEV_USER_ID=user-global-admin
CAMERA_USERNAME=admin
CAMERA_PASSWORD=change-me
ONVIF_ENDPOINTS=
EDGE_BRIDGE_SHARED_KEY=
CONTROL_PLANE_TIMEOUT_MS=15000
EDGE_LOG_PATH=./logs/edge-agent.log
PUBLIC_MEDIA_GATEWAY_URL=
EDGE_MEDIA_SHARED_KEY=
STREAM_SECRET_STORE_PATH=./data/stream-secrets.json
STREAM_SECRET_PROVIDER_HOST=127.0.0.1
STREAM_SECRET_PROVIDER_PORT=8093
DISCOVERY_TIMEOUT_MS=5000
ONVIF_TIMEOUT_MS=8000
FFPROBE_PATH=ffprobe
# ffmpeg extracts a decoded 64x36 luminance frame for freeze/black-screen checks.
FFMPEG_PATH=ffmpeg
LIVE_MEDIA_ENABLED=false
EDGE_LIVE_GATEWAY_HOST=127.0.0.1
EDGE_LIVE_GATEWAY_PORT=8090
MEDIAMTX_PATH=mediamtx
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_HLS_URL=http://127.0.0.1:8888
# quick is zero-configuration/test-only; named requires a Cloudflare tunnel
# token and stable PUBLIC_MEDIA_GATEWAY_URL.
MEDIA_TUNNEL_MODE=disabled
CLOUDFLARED_PATH=cloudflared
CLOUDFLARED_TUNNEL_TOKEN=
MEDIA_ACCESS_TTL_SECONDS=300
CAMERA_HEARTBEAT_INTERVAL_MS=30000
CAMERA_CONFIG_REFRESH_MS=60000
# Configure one or more WAN links. interfaceName enables OS traffic-counter utilization.
# Use independent targets reachable through the intended link/routing policy.
INTERNET_LINKS_JSON=[{"id":"primary","role":"primary","ispName":"Primary ISP","interfaceName":"eth0","gatewayAddress":"192.0.2.1","publicIpEndpoint":"https://monitoring.example.com/public-ip","targets":["https://monitoring.example.com/health","https://monitoring.example.com/health-secondary"],"contractedDownMbps":100,"contractedUpMbps":50},{"id":"backup","role":"backup","ispName":"Backup ISP","sourceAddress":"192.0.2.10","interfaceName":"eth1","gatewayAddress":"192.0.2.2","publicIpEndpoint":"https://monitoring.example.com/public-ip","targets":["https://monitoring.example.com/health","https://monitoring.example.com/health-secondary"],"contractedDownMbps":50,"contractedUpMbps":20}]
INTERNET_PROBE_TIMEOUT_MS=3000
INTERNET_PROBE_ATTEMPTS=3
INTERNET_PATH_WINDOW_MS=300000
# Credentials remain inside the branch edge agent. Custom paths support documented KVMS/OEM endpoints.
RECORDERS_JSON=[{"id":"nvr-branch-01","name":"Main NVR","deviceType":"nvr","vendor":"hikvision","model":"DS-7608","host":"192.168.1.20","port":80,"username":"admin","password":"change-me"},{"id":"dvr-branch-01","name":"CP PLUS DVR","deviceType":"dvr","vendor":"cp-plus","host":"192.168.1.21","port":80,"username":"admin","password":"change-me"}]
RECORDER_POLL_INTERVAL_MS=30000
RECORDER_PROBE_TIMEOUT_MS=5000
