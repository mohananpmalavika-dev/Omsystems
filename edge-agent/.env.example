# Edge Agent Configuration Example
# Copy this file to .env and update with your actual values

# Control Plane Connection
CONTROL_PLANE_URL=http://3.7.216.169:8080
CONTROL_PLANE_SHARED_TOKEN=348b3a216fa3db721dc48c69953da0c66e4d89c64d14e6c182a737b07c3fce3d

# Edge Bridge Authentication
EDGE_BRIDGE_SHARED_KEY=WBRrQzol9gGTuIEAVd08kvMFP5pfyNDj1m32qZ7YsShOcxHa

# Media Gateway Settings
EDGE_LIVE_GATEWAY_HOST=0.0.0.0
EDGE_LIVE_GATEWAY_PORT=8090
EDGE_MANAGED_MEDIA_BOOTSTRAP=true
MEDIA_RUNTIME_MANAGED=true

# Public Media Gateway URL (for remote access)
# Set this if you have a public tunnel (ngrok, cloudflare, etc.)
PUBLIC_MEDIA_GATEWAY_URL=auto

# Database Connection (for camera metadata)
DATABASE_URL=postgresql://sentinel_admin:password@your-aws-db-endpoint:5432/sentinel_grid

# Agent Identity (optional - auto-generated if not provided)
# EDGE_AGENT_ID=your-agent-id-here

# Logging
LOG_LEVEL=info

# Camera Scanning (optional)
# DISCOVERY_NETWORK=192.168.29.0/24
# DISCOVERY_ENABLED=true

# Analytics Engine (optional - for AI detection)
ANALYTICS_ENGINE_URL=http://3.7.216.169:8092
ANALYTICS_ENGINE_SHARED_KEY=KpGDyYCgIlZrOuHXLS5tE0FRe73M9Qj1UAv8csBzJnWTamPV

# MediaMTX Configuration
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_PATH=mediamtx

# Snapshot Push Settings
SNAPSHOT_PUSH_ENABLED=true
SNAPSHOT_PUSH_INTERVAL_MS=1000
SNAPSHOT_RELAY_URL=http://localhost:3000/api/media/snapshot-relay
