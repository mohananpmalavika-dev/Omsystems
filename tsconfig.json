{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    
    // STRICT MODE ENABLED
    // Production code should be type-safe
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false, // Still too strict for some legacy code
    
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "backend/**/*.ts",
    "packages/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    
    // Test files have their own configuration
    "**/*.test.ts",
    "test/**/*",
    
    // Workspace projects have their own tsconfig
    "dashboard/**/*",
    "edge-agent/**/*",
    "media-gateway/**/*",
    "recording-engine/**/*",
    "analytics-engine/**/*",
    
    // React/UI components (frontend only, not part of backend build)
    "src/**/ui/**/*",
    "backend/**/ui/**/*",
    
    // Example files (not needed for production)
    "**/*.example.ts",
    "**/*.example.js",
    
    // Temporarily exclude files with known type issues
    // TODO: Fix these files and remove from exclusions
    "src/routes/*.disabled",
    "src/maintenance/*.disabled"
  ]
}
