{
  "name": "sentinel-grid",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "dashboard",
    "edge-agent",
    "media-gateway",
    "recording-engine",
    "analytics-engine"
  ],
  "description": "Hybrid CCTV control plane for multi-branch organizations",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck:all": "npm run typecheck && npm run typecheck --workspaces --if-present",
    "build:all": "npm run build && npm run build --workspaces --if-present",
    "test:smoke": "vitest run test/app.test.ts test/authorization.test.ts test/device-inventory.routes.test.ts test/maintenance.routes.test.ts test/live-view-flow.test.ts test/operational-health.test.ts dashboard/test/control-proxy.test.ts dashboard/test/proxy.test.ts dashboard/test/recording-proxy.test.ts analytics-engine/test/app.test.ts media-gateway/test/app.test.ts",
    "test:phase1": "vitest run test/operational-health.test.ts test/recording.test.ts test/app.test.ts",
    "test:phase2": "vitest run test/phase2-dashboard.test.ts test/operational-health.test.ts test/live-view-flow.test.ts dashboard/test/control-proxy.test.ts",
    "test:phase3": "vitest run test/phase3-alert-command-center.test.ts test/analytics.test.ts dashboard/test/control-proxy.test.ts",
    "ci:phase0": "npm run typecheck:all && npm run build:all && npm run test:smoke",
    "ci:phase1": "npm run typecheck:all && npm run build:all && npm run test:smoke && npm run test:phase1",
    "ci:phase2": "npm run ci:phase1 && npm run test:phase2",
    "ci:phase3": "npm run ci:phase2 && npm run test:phase3",
    "migrate": "node scripts/run-migrations.mjs",
    "migrate:status": "node scripts/run-migrations.mjs status",
    "migrate:test": "node scripts/test-migrations-local.mjs",
    "edge:dev": "npm run dev --workspace @sentinel/edge-agent",
    "edge:typecheck": "npm run typecheck --workspace @sentinel/edge-agent",
    "edge:test": "npm run test --workspace @sentinel/edge-agent",
    "media:dev": "npm run dev --workspace @sentinel/media-gateway",
    "media:typecheck": "npm run typecheck --workspace @sentinel/media-gateway",
    "media:test": "npm run test --workspace @sentinel/media-gateway",
    "recording:dev": "npm run dev --workspace @sentinel/recording-engine",
    "recording:typecheck": "npm run typecheck --workspace @sentinel/recording-engine",
    "analytics:dev": "npm run dev --workspace @sentinel/analytics-engine",
    "analytics:typecheck": "npm run typecheck --workspace @sentinel/analytics-engine",
    "analytics:test": "npm run test --workspace @sentinel/analytics-engine",
    "dashboard:dev": "npm run dev --workspace @sentinel/dashboard",
    "dashboard:typecheck": "npm run typecheck --workspace @sentinel/dashboard",
    "dashboard:build": "npm run build --workspace @sentinel/dashboard"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node-cron": "^3.0.11",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.6",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "leaflet": "^1.9.4",
    "node-cron": "^4.6.0",
    "papaparse": "^5.5.4",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
