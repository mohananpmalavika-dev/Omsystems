{
  "name": "sentinel-grid",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "dashboard",
    "edge-agent",
    "media-gateway",
    "recording-engine",
    "analytics-engine",
    "packages/*"
  ],
  "description": "Hybrid CCTV control plane for multi-branch organizations",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:exe": "npm run build:exe --workspace @sentinel/edge-agent",
    "build:edge-delta": "npm run bundle:delta --workspace @sentinel/edge-agent",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:strict": "tsc -p tsconfig.json --noEmit --strict",
    "test": "vitest run",
    "typecheck:all": "npm run typecheck && npm run typecheck:test && npm run typecheck --workspaces --if-present",
    "build:all": "npm run build && npm run build --workspaces --if-present && npm run build:exe",
    "test:smoke": "vitest run test/app.test.ts test/authorization.test.ts test/device-inventory.routes.test.ts test/maintenance.routes.test.ts test/live-view-flow.test.ts test/operational-health.test.ts test/analog-dvr-channels.test.ts test/enterprise-infrastructure.test.ts edge-agent/test/dvr-adapter.test.ts edge-agent/test/analog-signal-quality.test.ts dashboard/test/control-proxy.test.ts dashboard/test/proxy.test.ts dashboard/test/recording-proxy.test.ts analytics-engine/test/app.test.ts media-gateway/test/app.test.ts",
    "test:phase1": "vitest run test/operational-health.test.ts test/recording.test.ts test/app.test.ts",
    "test:phase2": "vitest run test/phase2-dashboard.test.ts test/operational-health.test.ts test/live-view-flow.test.ts dashboard/test/control-proxy.test.ts dashboard/test/branch-health-mosaic.test.ts dashboard/test/branch-camera-wall.test.ts",
    "test:phase3": "vitest run test/phase3-alert-command-center.test.ts test/analytics.test.ts dashboard/test/control-proxy.test.ts dashboard/test/global-alert-center.test.ts",
    "test:phase4": "vitest run test/phase4-operational-reports.test.ts test/operational-health.test.ts test/phase3-alert-command-center.test.ts dashboard/test/control-proxy.test.ts",
    "test:phase5": "vitest run test/phase5-enterprise-readiness.test.ts test/phase4-operational-reports.test.ts test/phase3-alert-command-center.test.ts test/operational-health.test.ts",
    "test:phase6": "vitest run test/phase6-testing-deployment.test.ts test/phase5-enterprise-readiness.test.ts test/phase4-operational-reports.test.ts test/phase3-alert-command-center.test.ts",
    "test:hdd:all": "tsx test/hdd-health/test-runner.ts all",
    "test:hdd:connectivity": "tsx test/hdd-health/test-runner.ts connectivity",
    "test:hdd:compatibility": "tsx test/hdd-health/test-runner.ts compatibility",
    "test:hdd:smart": "tsx test/hdd-health/smart-hdd-health-runner.ts",
    "test:recorder:compatibility": "tsx test/recorder-compatibility/test-runner.ts",
    "test:recorder:formal": "tsx test/recorder-compatibility/formal-compatibility-test-runner.ts",
    "test:recorder:adapters": "vitest run backend/src/recorders/__tests__/",
    "test:recorder:canonical": "tsx test/recorder-sdk/canonical-driver-runner.ts",
    "test:camera:health": "tsx test/camera-health/camera-health-runner.ts",
    "test:retention": "tsx test/retention/retention-runner.ts",
    "test:alert:audio": "tsx test/alert-audio/alert-audio-runner.ts",
    "test:notifications": "tsx test/notifications/notification-consolidation-runner.ts",
    "test:reports:daily": "tsx test/reporting/daily-surveillance-report-runner.ts",
    "test:device:capabilities": "tsx test/device-health/device-health-capability-runner.ts",
    "test:recording:continuity": "tsx test/recording-continuity/recording-continuity-runner.ts",
    "test:monitoring:queue": "tsx test/monitoring/central-monitoring-queue-runner.ts",
    "test:media:on-demand": "tsx test/media/on-demand-video-runner.ts",
    "test:alerts:normalized": "tsx test/alerts/unified-ai-alerts-runner.ts",
    "test:incidents:storm": "tsx test/incidents/alert-storm-suppression-runner.ts",
    "test:perf:capacity": "tsx test/performance/capacity-benchmark-runner.ts",
    "test:telemetry:edge": "tsx test/telemetry/edge-telemetry-ingestion-runner.ts",
    "test:telemetry:stale": "tsx test/telemetry/stale-data-semantics-runner.ts",
    "test:maintenance:windows": "tsx test/maintenance/maintenance-windows-runner.ts",
    "test:operations:unified": "tsx test/operations/unified-product-surface-runner.ts",
    "test:branch:command-center": "tsx test/branch-command-center/test-runner.ts",
    "test:branch:e2e": "tsx test/branch-command-center/command-center-e2e-runner.ts",
    "test:video-wall": "tsx test/video-wall/test-runner.ts",
    "test:viewer-capacity": "tsx test/viewer-capacity/test-runner.ts",
    "test:internet:acceptance": "tsx test/internet-health/test-runner.ts",
    "test:internet:connectivity": "tsx test/internet-health/branch-connectivity-runner.ts",
    "test:alerts:operations": "tsx test/alerts/alert-operations-runner.ts",
    "test:notifications:recipients": "tsx test/notifications/recipient-resolution-runner.ts",
    "test:sla:historical": "tsx test/sla/sla-historical-aggregation-runner.ts",
    "test:clock:drift": "tsx test/clock-monitoring/clock-monitoring-runner.ts",
    "test:edge:separation": "tsx test/edge-protocol/control-media-separation-runner.ts",
    "test:evidence:guaranteed": "tsx test/evidence/guaranteed-evidence-capture-runner.ts",
    "test:alerts:dedup": "tsx test/alerts/alert-deduplication-runner.ts",
    "test:twin:health": "tsx test/digital-twin/twin-branch-health-runner.ts",
    "test:onboarding:superadmin": "tsx test/identity/onboarding-superadmin-runner.ts",
    "test:stale:semantics": "tsx test/operational-health/stale-semantics-runner.ts",
    "test:surveillance:policy": "tsx test/surveillance-policy/surveillance-policy-runner.ts",
    "test:p0:readiness": "tsx test/p0-readiness/p0-implementation-runner.ts",
    "test:local:ai": "tsx test/ai/local-ai-pipeline.test.ts",
    "test:hdd:collect": "tsx test/hdd-health/test-runner.ts collect",
    "test:hdd:thresholds": "tsx test/hdd-health/test-runner.ts thresholds",
    "test:hdd:parsing": "tsx test/hdd-health/test-runner.ts parsing",
    "test:hdd:failure-scenarios": "tsx test/hdd-health/test-runner.ts failures",
    "ci:phase0": "npm run typecheck:all && npm run build:all && npm run test:smoke",
    "ci:phase1": "npm run typecheck:all && npm run build:all && npm run test:smoke && npm run test:phase1",
    "ci:phase2": "npm run ci:phase1 && npm run test:phase2",
    "ci:phase3": "npm run ci:phase2 && npm run test:phase3",
    "ci:phase4": "npm run ci:phase3 && npm run test:phase4",
    "ci:phase5": "npm run ci:phase4 && npm run test:phase5",
    "ci:phase6": "npm run ci:phase5 && npm run test:phase6",
    "migrate": "node scripts/run-migrations.mjs",
    "migrate:status": "node scripts/run-migrations.mjs status",
    "migrate:test": "node scripts/test-migrations-local.mjs",
    "backup:database": "node scripts/backup-postgres.mjs",
    "restore:database": "node scripts/restore-postgres.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "security:secret-scan": "node scripts/secret-scan.mjs",
    "release:preflight": "node scripts/phase6-release.mjs",
    "release:production": "node scripts/phase6-release.mjs --apply --confirm-production",
    "release:rollback": "node scripts/phase6-rollback.mjs --confirm-rollback",
    "render:check": "node scripts/check-render-config.mjs",
    "render:test-health": "node scripts/test-render-health.mjs",
    "render:diagnose": "node scripts/diagnose-render-502.md || type scripts\\diagnose-render-502.md",
    "edge:dev": "npm run dev --workspace @sentinel/edge-agent",
    "edge:build:clean": "npm run build:clean --workspace @sentinel/edge-agent",
    "edge:typecheck": "npm run typecheck --workspace @sentinel/edge-agent",
    "edge:test": "npm run test --workspace @sentinel/edge-agent",
    "media:dev": "npm run dev --workspace @sentinel/media-gateway",
    "media:typecheck": "npm run typecheck --workspace @sentinel/media-gateway",
    "media:test": "npm run test --workspace @sentinel/media-gateway",
    "recording:dev": "npm run dev --workspace @sentinel/recording-engine",
    "recording:typecheck": "npm run typecheck --workspace @sentinel/recording-engine",
    "analytics:dev": "npm run dev --workspace @sentinel/analytics-engine",
    "analytics:typecheck": "npm run typecheck --workspace @sentinel/analytics-engine",
    "analytics:test": "npm run test --workspace @sentinel/analytics-engine",
    "dashboard:dev": "npm run dev --workspace @sentinel/dashboard",
    "dashboard:typecheck": "npm run typecheck --workspace @sentinel/dashboard",
    "dashboard:build": "npm run build --workspace @sentinel/dashboard",
    "cameras:delete:all": "node scripts/delete-cameras.mjs --all --confirm",
    "cameras:delete:dry-run": "node scripts/delete-cameras.mjs --all --dry-run",
    "cameras:delete:test": "node scripts/delete-cameras.mjs --test --confirm",
    "cameras:delete:branch": "node scripts/delete-cameras.mjs --branch",
    "cameras:delete:id": "node scripts/delete-cameras.mjs --id",
    "db:delete:cameras-and-edges": "node scripts/delete-all-cameras-and-edges.mjs",
    "db:nuke:cameras": "node scripts/delete-all-cameras-and-edges.mjs",
    "fix:org-visibility": "node fix-org-visibility.mjs",
    "diagnose:org": "psql $DATABASE_URL -f diagnose-org-issue.sql"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.0.0",
    "@aws-sdk/client-sns": "^3.1109.0",
    "@fastify/cors": "^11.0.0",
    "@node-saml/passport-saml": "^5.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/node-cron": "^3.0.11",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.6",
    "axios": "^1.6.7",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "ldapjs": "^3.0.7",
    "ldapts": "^9.0.0",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.10",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "node-forge": "^1.3.1",
    "nodemailer": "^7.0.13",
    "openid-client": "^6.8.4",
    "papaparse": "^5.5.4",
    "passport-saml": "^3.2.4",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.0",
    "redis": "^6.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "speakeasy": "^2.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/ldapjs": "^3.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.21",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^10.0.0",
    "fast-check": "^4.9.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
