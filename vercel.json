{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd dashboard && npm install && npm run build",
  "outputDirectory": "dashboard/.next",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://sentinel-grid-api.up.railway.app/v1/:path*" },
    { "source": "/api/v1/:path*", "destination": "https://sentinel-grid-api.up.railway.app/api/v1/:path*" },
    { "source": "/internal/:path*", "destination": "https://sentinel-grid-api.up.railway.app/internal/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "microphone=(self), camera=(), geolocation=()" }
      ]
    }
  ]
}
