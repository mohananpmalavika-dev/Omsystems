# Local Development Configuration

# Use relative paths for API calls (proxied through Next.js)
NEXT_PUBLIC_API_BASE=/api/control

# Control plane URL (for server-side requests from dashboard backend)
CONTROL_PLANE_PUBLIC_URL=http://3.7.216.169:8080
CONTROL_PLANE_INTERNAL_URL=http://3.7.216.169:8080

# API URL for Next.js API routes (used by audit/maintenance routes)
NEXT_PUBLIC_API_URL=http://3.7.216.169:8080

# Media gateway routing. The dashboard and branch Edge Agent run on this
# computer, so use the local listener first for live video. The internal URL
# remains as a tunnel/central fallback for sessions without a local route.
MEDIA_GATEWAY_LOCAL_URL=http://127.0.0.1:8090
MEDIA_GATEWAY_INTERNAL_URL=http://3.7.216.169:8090

# Edge bridge shared key for authenticating with backend
# EDGE_BRIDGE_SHARED_KEY is a secret. DO NOT commit real keys.
# Configure EDGE_BRIDGE_SHARED_KEY in your environment or in an untracked .env file.
EDGE_BRIDGE_SHARED_KEY=change-me-in-your-env

# Dashboard demo mode (set to false to use real backend)
DASHBOARD_DEMO_MODE=false
