{
  "name": "@sentinel/analytics-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest test/detectors.test.ts",
    "test:integration": "jest test/pipeline.test.ts",
    "test:api": "jest test/api.test.ts",
    "test:performance": "jest test/performance.test.ts --maxWorkers=1",
    "test:coverage": "jest --coverage --coverageReporters=html",
    "lint": "eslint src test --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "zod": "^3.24.2",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
