{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "../src/events/**/*.ts",
    "scripts/**/*.ts",
    "test/app.test.ts",
    "test/inference.test.ts",
    "test/model-manager.test.ts",
    "test/specialty-inference.test.ts"
  ],
  "exclude": [
    "src/**/__tests__/**/*.ts",
