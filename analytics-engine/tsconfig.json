    "src/monitoring/**/*.ts",
    "src/detectors/ai-assistant.ts",
    "src/detectors/ai-investigation-tools.ts",
    "src/detectors/ai-prediction-engine.ts",
    "src/detectors/ai-reporting-engine.ts",
    "src/detectors/ai-search-engine.ts",
    "src/detectors/enhanced-security-analytics.ts",
    "src/detectors/human-analytics.ts",
    "src/detectors/vehicle-analytics.ts",
    "src/detectors/face-analytics.ts",
    "src/detectors/safety-analytics.ts",
    "src/detectors/banking-analytics.ts",
    "src/detectors/industrial-analytics.ts",
    "src/detectors/retail-analytics.ts",
    "src/detectors/smart-city-analytics.ts"
  ]
