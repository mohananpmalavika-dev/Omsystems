{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "dist",
    "types": ["node"],
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "include": [
    "src/**/*.ts",
    "../src/events/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "src/**/__tests__/**/*.ts",
    "src/**/*.test.ts",
    "test/**/*.ts",
    "../backend/**/*",
    "../src/services/**/*",
    "../src/routes/**/*",
    "../src/middleware/**/*"
  ]
}
