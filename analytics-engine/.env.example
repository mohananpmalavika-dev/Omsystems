# Analytics Engine Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8092

# Control Plane Integration
CONTROL_PLANE_URL=http://localhost:4000
ANALYTICS_ENGINE_SHARED_KEY=your-analytics-engine-secret-key-min-32-chars
ANALYTICS_SOURCE_SHARED_KEY=your-analytics-source-secret-key-min-32-chars

# Environment
NODE_ENV=development

# ============================================================================
# ML Model Paths
# ============================================================================

# Set true in production so readiness fails instead of silently running with
# zero local models. Development may leave this false when using normalized
# observations from an authenticated edge inference worker.
ANALYTICS_REQUIRE_MODELS=false
MODEL_MANIFEST_PATH=./models/manifest.json

# Free general object detector bundled by the production image. The official
# source URL and audited checksum live in models/manifest.json.
YOLO_MODEL_PATH=./models/detection/yolox_tiny.onnx

# Specialized Detection Models
HELMET_MODEL_PATH=./models/safety/helmet.onnx
FIRE_SMOKE_MODEL_PATH=./models/safety/fire-smoke.onnx
FACE_DETECTION_MODEL_PATH=./models/face/face-detector.onnx
FACE_EMBEDDING_MODEL_PATH=./models/face/face-embedding.onnx
ANPR_DETECTION_MODEL_PATH=./models/vehicle/license-plate-detector.onnx
ANPR_RECOGNITION_MODEL_PATH=./models/vehicle/license-plate-recognizer.onnx

# Secure provisioning requires an approved HTTPS URL and audited SHA-256 for
# each artifact. Review the model licenses, then run `npm run models:download`.
ANALYTICS_MODEL_LICENSES_ACCEPTED=false
HELMET_MODEL_URL=
HELMET_MODEL_SHA256=
FIRE_SMOKE_MODEL_URL=
FIRE_SMOKE_MODEL_SHA256=
FACE_DETECTION_MODEL_URL=
FACE_DETECTION_MODEL_SHA256=
FACE_EMBEDDING_MODEL_URL=
FACE_EMBEDDING_MODEL_SHA256=
ANPR_DETECTION_MODEL_URL=
ANPR_DETECTION_MODEL_SHA256=
ANPR_RECOGNITION_MODEL_URL=
ANPR_RECOGNITION_MODEL_SHA256=

# ============================================================================
# Detection Thresholds
# ============================================================================

PERSON_CONFIDENCE_THRESHOLD=0.5
VEHICLE_CONFIDENCE_THRESHOLD=0.6
HELMET_CONFIDENCE_THRESHOLD=0.7
FACE_CONFIDENCE_THRESHOLD=0.75
FACE_RECOGNITION_ENABLED=false
ANPR_CONFIDENCE_THRESHOLD=0.8
ANPR_PLATE_CONFIDENCE_THRESHOLD=0.7
ANPR_COUNTRY_CODE=IN
FIRE_CONFIDENCE_THRESHOLD=0.65
FALL_CONFIDENCE_THRESHOLD=0.7

# ============================================================================
# Performance Configuration
# ============================================================================

# Maximum number of concurrent video streams to process
MAX_CONCURRENT_STREAMS=30

# Frame processing rate (FPS for analytics, not recording)
# Recommended: 1-2 FPS for analytics vs 25-30 FPS for recording
FRAME_PROCESSING_RATE=1

# Enable GPU acceleration (CUDA, OpenVINO, etc.)
ENABLE_GPU_ACCELERATION=false

# Worker threads for parallel processing
WORKER_THREADS=4

# ============================================================================
# Heat Map Configuration
# ============================================================================

HEATMAP_GRID_WIDTH=32
HEATMAP_GRID_HEIGHT=18
HEATMAP_DECAY_RATE=0.05
HEATMAP_UPDATE_INTERVAL=60

# ============================================================================
# Tracking Configuration
# ============================================================================

# Person tracking
PERSON_TRACKING_TIMEOUT_MS=5000
PERSON_STATIONARY_THRESHOLD_PIXELS=20

# Vehicle tracking
VEHICLE_TRACKING_TIMEOUT_MS=10000

# ============================================================================
# Logging
# ============================================================================

LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=./logs/analytics-engine.log

# ============================================================================
# Monitoring
# ============================================================================

# Prometheus metrics
ENABLE_METRICS=true
METRICS_PORT=9092

# Health check
HEALTH_CHECK_INTERVAL_MS=30000
