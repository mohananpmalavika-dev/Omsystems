# Analytics Engine Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8092

# Control Plane Integration
CONTROL_PLANE_URL=http://localhost:4000
ANALYTICS_ENGINE_SHARED_KEY=your-analytics-engine-secret-key-min-32-chars
ANALYTICS_SOURCE_SHARED_KEY=your-analytics-source-secret-key-min-32-chars

# Environment
NODE_ENV=development

# ============================================================================
# ML Model Paths
# ============================================================================

# Object Detection Models
YOLO_MODEL_PATH=./models/yolov8n.onnx
PERSON_MODEL_PATH=./models/person-detection-v2.onnx
VEHICLE_MODEL_PATH=./models/vehicle-detection-v2.onnx

# Specialized Detection Models
HELMET_MODEL_PATH=./models/helmet-detection-v1.onnx
FACE_MODEL_PATH=./models/face-recognition-v1.onnx
ANPR_MODEL_PATH=./models/anpr-v2.onnx
FIRE_SMOKE_MODEL_PATH=./models/fire-smoke-v1.onnx
FALL_MODEL_PATH=./models/fall-detection-v1.onnx

# ============================================================================
# Detection Thresholds
# ============================================================================

PERSON_CONFIDENCE_THRESHOLD=0.5
VEHICLE_CONFIDENCE_THRESHOLD=0.6
HELMET_CONFIDENCE_THRESHOLD=0.7
FACE_CONFIDENCE_THRESHOLD=0.75
ANPR_CONFIDENCE_THRESHOLD=0.8
FIRE_CONFIDENCE_THRESHOLD=0.65
FALL_CONFIDENCE_THRESHOLD=0.7

# ============================================================================
# Performance Configuration
# ============================================================================

# Maximum number of concurrent video streams to process
MAX_CONCURRENT_STREAMS=30

# Frame processing rate (FPS for analytics, not recording)
# Recommended: 1-2 FPS for analytics vs 25-30 FPS for recording
FRAME_PROCESSING_RATE=1

# Enable GPU acceleration (CUDA, OpenVINO, etc.)
ENABLE_GPU_ACCELERATION=false

# Worker threads for parallel processing
WORKER_THREADS=4

# ============================================================================
# Heat Map Configuration
# ============================================================================

HEATMAP_GRID_WIDTH=32
HEATMAP_GRID_HEIGHT=18
HEATMAP_DECAY_RATE=0.05
HEATMAP_UPDATE_INTERVAL=60

# ============================================================================
# Tracking Configuration
# ============================================================================

# Person tracking
PERSON_TRACKING_TIMEOUT_MS=5000
PERSON_STATIONARY_THRESHOLD_PIXELS=20

# Vehicle tracking
VEHICLE_TRACKING_TIMEOUT_MS=10000

# ============================================================================
# Logging
# ============================================================================

LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=./logs/analytics-engine.log

# ============================================================================
# Monitoring
# ============================================================================

# Prometheus metrics
ENABLE_METRICS=true
METRICS_PORT=9092

# Health check
HEALTH_CHECK_INTERVAL_MS=30000
