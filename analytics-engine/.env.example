# ============================================================================
# Analytics Engine Configuration - Production-Ready
# ============================================================================
# Complete configuration for Sentinel Grid Analytics Engine
# Copy this file to .env and update values for your environment
# Last Updated: 2026-09-15
# ============================================================================

# ============================================================================
# Server Configuration
# ============================================================================

HOST=0.0.0.0
PORT=8092
NODE_ENV=development

# Environment mode (affects error handling, logging verbosity)
DEPLOYMENT_MODE=development             # development, staging, production

# ============================================================================
# Control Plane Integration
# ============================================================================

CONTROL_PLANE_URL=http://localhost:4000
ANALYTICS_ENGINE_SHARED_KEY=your-analytics-engine-secret-key-min-32-chars
ANALYTICS_SOURCE_SHARED_KEY=your-analytics-source-secret-key-min-32-chars

# Optional incident API integration for automatic P1-P5 escalation
INCIDENT_API_URL=
INCIDENT_API_KEY=

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL connection for face recognition, industrial analytics persistence
# Leave empty to run in memory-only mode (not recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/sentinel_analytics

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000

# ============================================================================
# ML Model Configuration
# ============================================================================

# Require models to be present before starting (production: true, dev: false)
ANALYTICS_REQUIRE_MODELS=false
MODEL_MANIFEST_PATH=./models/manifest.json

# Model License Acceptance (set true after reviewing model licenses)
ANALYTICS_MODEL_LICENSES_ACCEPTED=false

# Model Verification (verify SHA-256 checksums on startup)
REQUIRE_MODEL_VERIFICATION=true
LOG_MODEL_VERSIONS=true

# ============================================================================
# Core Detection Models
# ============================================================================

# General Object Detection (YOLOX Tiny - Apache 2.0)
YOLO_MODEL_PATH=./models/detection/yolox_tiny.onnx

# Safety Models
HELMET_MODEL_PATH=./models/safety/helmet.onnx
FIRE_SMOKE_MODEL_PATH=./models/safety/fire-smoke.onnx

# Vehicle Models (ANPR)
ANPR_DETECTION_MODEL_PATH=./models/vehicle/license-plate-detector.onnx
ANPR_RECOGNITION_MODEL_PATH=./models/vehicle/license-plate-recognizer.onnx

# ============================================================================
# Face Recognition Configuration (Production-Ready)
# ============================================================================

# Enable face recognition features (requires model provisioning)
ENABLE_FACE_RECOGNITION=false

# Face Detection Model (YuNet - OpenCV Zoo - MIT License)
FACE_DETECTION_MODEL_PATH=./models/face/face-detector.onnx

# Face Embedding Models
# Option 1: SFace INT8 (fast, 128-dim, basic use cases)
FACE_EMBEDDING_MODEL_PATH=./models/face/face-embedding.onnx

# Option 2: ArcFace ResNet100 (production, 512-dim, 99.8% accuracy, BFSI-approved)
# Use this for banking, high-security, and compliance-critical deployments
ARCFACE_MODEL_PATH=./models/face/arcface_r100.onnx
ARCFACE_MODEL_URL=https://huggingface.co/onnxmodelzoo/arcfaceresnet100-8/resolve/main/arcfaceresnet100-8.onnx
ARCFACE_MODEL_SHA256=f3a6bc281e72f88862f5748b53be3d76b3b48f8f1ab1f4a537941bdc4e1b01da

# Face Quality Assessment (SER-FIQ - optional but recommended for enrollment)
FACE_QUALITY_MODEL_PATH=./models/face/face-quality.onnx
ENABLE_FACE_QUALITY_ASSESSMENT=true

# Face Liveness / Anti-Spoofing (required for BFSI compliance)
FACE_LIVENESS_MODEL_PATH=./models/face/face-liveness.onnx
ENABLE_FACE_LIVENESS_DETECTION=true

# Face Detection Thresholds (0.0 - 1.0)
FACE_DETECTION_CONFIDENCE=0.75
FACE_MATCH_THRESHOLD=0.70              # Minimum similarity for definitive match
FACE_REVIEW_THRESHOLD=0.60              # Similarity requiring human review
FACE_MINIMUM_MARGIN=0.05                # Min difference between 1st and 2nd match
FACE_MINIMUM_QUALITY=0.55               # Minimum face quality score
FACE_LIVENESS_THRESHOLD=0.95            # Minimum liveness score (BFSI: ≥0.95)

# Temporal Confirmation (prevent false positives)
FACE_TEMPORAL_CONFIRMATION_FRAMES=3     # Frames needed before alerting (BFSI: ≥3)
FACE_TEMPORAL_WINDOW_SECONDS=2          # Time window for temporal confirmation

# BFSI Compliance Flags
FACE_REQUIRE_CONSENT=true               # Enforce biometric consent before processing
FACE_REQUIRE_LIVENESS=true              # Enforce liveness detection
FACE_REQUIRE_HUMAN_REVIEW=true          # Require human review for P1/P2 alerts
FACE_RETENTION_DAYS=90                  # Face event retention period (adjust per regulation)
FACE_AUDIT_ALL_OPERATIONS=true          # Log all biometric operations
FACE_LOCAL_PROCESSING_ONLY=true         # Never send face data to external APIs

# ============================================================================
# Industrial Analytics Configuration
# ============================================================================

# Enable industrial equipment detection and safety analytics
ENABLE_INDUSTRIAL_ANALYTICS=false

# Industrial Equipment Detection Model
INDUSTRIAL_EQUIPMENT_MODEL_PATH=./models/industrial/equipment-detector.onnx

# Safety Configuration (distances in pixels at 1080p resolution)
MIN_PERSON_EQUIPMENT_DISTANCE=150       # Unsafe proximity threshold (pixels)
EQUIPMENT_IDLE_THRESHOLD_SECONDS=300    # Equipment idle too long (5 minutes)
EQUIPMENT_STATIONARY_THRESHOLD=60       # Equipment stationary detection (1 minute)
ENFORCE_ZONE_RESTRICTIONS=true          # Enable zone violation detection

# Industrial Detection Confidence
EQUIPMENT_CONFIDENCE_THRESHOLD=0.65
PPE_CONFIDENCE_THRESHOLD=0.70
SAFETY_VIOLATION_CONFIDENCE=0.75

# ============================================================================
# Banking/BFSI Specialized Analytics
# ============================================================================

# Enable banking-specific analytics (vault, ATM, cash counter, dual control)
ENABLE_BANKING_ANALYTICS=false

# Banking Security Models (optional - requires separate provisioning)
WEAPON_DETECTOR_MODEL_PATH=./models/security/weapon-detector.onnx
ATM_TAMPER_MODEL_PATH=./models/security/atm-tamper-detector.onnx
ACOUSTIC_SECURITY_MODEL_PATH=./models/audio/acoustic-security.onnx

# Banking Detection Thresholds
WEAPON_CONFIDENCE_THRESHOLD=0.85
ATM_TAMPER_CONFIDENCE=0.80
ACOUSTIC_EVENT_CONFIDENCE=0.75

# ============================================================================
# Advanced Analytics Models (Optional)
# ============================================================================

# Pose Estimation (for fall detection, behavior analysis)
ENABLE_POSE_ESTIMATION=false
POSE_MODEL_PATH=./models/pose/yolov8n-pose.onnx
POSE_CONFIDENCE_THRESHOLD=0.65

# Person Re-Identification (cross-camera tracking)
ENABLE_PERSON_REID=false
PERSON_REID_MODEL_PATH=./models/tracking/osnet-reid.onnx
REID_SIMILARITY_THRESHOLD=0.70

# Vehicle Re-Identification
ENABLE_VEHICLE_REID=false
VEHICLE_REID_MODEL_PATH=./models/vehicle/vehicle-reid.onnx

# Attribute Estimation (age, gender, emotion)
ENABLE_ATTRIBUTE_ESTIMATION=false
ATTRIBUTE_MODEL_PATH=./models/attributes/age-gender-emotion.onnx

# ============================================================================
# Security Device Integration (SNMP/REST/MQTT)
# ============================================================================

# Enable security device integration (UPS, sensors, access control)
ENABLE_SECURITY_DEVICES=false

# SNMP Configuration
ENABLE_SNMP_DEVICES=false
SNMP_COMMUNITY_STRING=public
SNMP_TIMEOUT_MS=5000
SNMP_RETRIES=3
SNMP_VERSION=2c                         # 1, 2c, or 3

# SNMPv3 Authentication (if SNMP_VERSION=3)
SNMP_V3_USERNAME=
SNMP_V3_AUTH_PROTOCOL=SHA               # MD5, SHA, SHA224, SHA256, SHA384, SHA512
SNMP_V3_AUTH_PASSWORD=
SNMP_V3_PRIV_PROTOCOL=AES               # DES, AES, AES192, AES256
SNMP_V3_PRIV_PASSWORD=

# Device Discovery
ENABLE_DEVICE_DISCOVERY=false
DEVICE_DISCOVERY_INTERVAL_MINUTES=60

# ============================================================================
# Detection Thresholds (General)
# ============================================================================

PERSON_CONFIDENCE_THRESHOLD=0.5
VEHICLE_CONFIDENCE_THRESHOLD=0.6
HELMET_CONFIDENCE_THRESHOLD=0.7
ANPR_CONFIDENCE_THRESHOLD=0.8
ANPR_PLATE_CONFIDENCE_THRESHOLD=0.7
ANPR_COUNTRY_CODE=IN
FIRE_CONFIDENCE_THRESHOLD=0.65
FALL_CONFIDENCE_THRESHOLD=0.7

# ============================================================================
# Performance Configuration
# ============================================================================

# Concurrency Limits
MAX_CONCURRENT_STREAMS=30
WORKER_THREADS=4

# Frame Processing
FRAME_PROCESSING_RATE=1                 # FPS for analytics (1-2 recommended)

# GPU Acceleration
ENABLE_GPU_ACCELERATION=false
GPU_DEVICE_ID=0

# Memory Management
MAX_MEMORY_MB=8192
ENABLE_MEMORY_MONITORING=true
MEMORY_WARNING_THRESHOLD_PERCENT=80

# Processing Limits
MAX_DETECTIONS_PER_FRAME=2000
MAX_TRACKS_PER_CAMERA=500
MAX_ZONES_PER_CAMERA=50
MAX_RULES_PER_CAMERA=100

# Timeouts
DETECTION_TIMEOUT_MS=1000
INFERENCE_TIMEOUT_MS=500
API_REQUEST_TIMEOUT_MS=30000

# ============================================================================
# Tracking Configuration
# ============================================================================

# Person Tracking
PERSON_TRACKING_TIMEOUT_MS=5000
PERSON_STATIONARY_THRESHOLD_PIXELS=20
PERSON_TRACK_MIN_OBSERVATIONS=3

# Vehicle Tracking
VEHICLE_TRACKING_TIMEOUT_MS=10000
VEHICLE_TRACK_MIN_OBSERVATIONS=3

# ============================================================================
# Heat Map Configuration
# ============================================================================

HEATMAP_GRID_WIDTH=32
HEATMAP_GRID_HEIGHT=18
HEATMAP_DECAY_RATE=0.05
HEATMAP_UPDATE_INTERVAL=60

# ============================================================================
# Event Storage & Retention
# ============================================================================

MAX_EVENT_RETENTION_DAYS=365
MAX_EVENTS_PER_QUERY=10000
ENABLE_EVENT_COMPRESSION=true

# ============================================================================
# API Rate Limiting
# ============================================================================

MAX_API_REQUESTS_PER_MINUTE=1000
MAX_FRAME_SUBMISSIONS_PER_SECOND=100
ENABLE_RATE_LIMITING=true

# ============================================================================
# Logging Configuration
# ============================================================================

LOG_LEVEL=info                          # error, warn, info, debug, trace
LOG_FORMAT=json                         # json, pretty
LOG_FILE=./logs/analytics-engine.log
LOG_MAX_SIZE=100M
LOG_MAX_FILES=10

# Audit Logging
ENABLE_AUDIT_LOG=true
AUDIT_LOG_FILE=./logs/analytics-audit.log
AUDIT_LOG_RETENTION_DAYS=365

# ============================================================================
# Monitoring & Metrics
# ============================================================================

# Prometheus Metrics
ENABLE_METRICS=true
METRICS_PORT=9092
METRICS_PATH=/metrics

# Health Checks
HEALTH_CHECK_INTERVAL_MS=30000
ENABLE_DETAILED_HEALTH=true

# ============================================================================
# Notification Configuration
# ============================================================================

# Webhooks
NOTIFICATION_WEBHOOK_URL=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_RETRY_ATTEMPTS=3

# Email Notifications
NOTIFICATION_EMAIL_SMTP_HOST=
NOTIFICATION_EMAIL_SMTP_PORT=587
NOTIFICATION_EMAIL_SECURE=true
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=

# Alert Configuration
P1_ALERT_ESCALATION_MINUTES=5
P2_ALERT_ESCALATION_MINUTES=15
ALERT_COOLDOWN_SECONDS=60
ALERT_BATCH_WINDOW_SECONDS=10
ALERT_DEDUPLICATION_WINDOW_SECONDS=300

# ============================================================================
# Compliance & Privacy
# ============================================================================

# Data Privacy
ANONYMIZE_PII=false                     # Anonymize personal data in logs
MASK_FACE_EMBEDDINGS=false              # Mask face embeddings in non-prod logs
ENABLE_GDPR_MODE=false                  # Enable GDPR compliance features
ENABLE_DATA_MINIMIZATION=true           # Only collect necessary data

# Regulatory Compliance
ENABLE_HIPAA_MODE=false                 # Healthcare compliance
ENABLE_SOC2_LOGGING=false               # SOC 2 compliance logging
ENABLE_ISO27001_MODE=false              # ISO 27001 compliance

# ============================================================================
# Feature Flags
# ============================================================================

ENABLE_BETA_FEATURES=false
ENABLE_EXPERIMENTAL_MODELS=false
ENABLE_DEBUG_MODE=false

# ============================================================================
# Telemetry & Error Reporting
# ============================================================================

ENABLE_TELEMETRY=false
SENTRY_DSN=
ERROR_REPORTING_ENDPOINT=
TELEMETRY_SAMPLE_RATE=0.1

# ============================================================================
# Development & Testing
# ============================================================================

# Development Helpers
ENABLE_HOT_RELOAD=false
ENABLE_REQUEST_LOGGING=false
ENABLE_RESPONSE_LOGGING=false
ENABLE_PERFORMANCE_PROFILING=false

# Testing Mode
TEST_MODE=false
MOCK_INFERENCE=false
MOCK_DATABASE=false

# ============================================================================
# End of Configuration
# ============================================================================
# Review all settings before deploying to production
# Refer to BFSI_PRODUCTION_READINESS.md for compliance requirements
# Model provisioning: ./scripts/provision-face-models.sh
# ============================================================================
